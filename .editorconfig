root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{svelte,vue,md,mdx,toml,svg,xml,sh,bash,zsh,ps1,sql}]
indent_style = space
indent_size = 2

[*.{py,pyi,rs}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = tab
tab_width = 8

[Makefile]
indent_style = tab
indent_size = tab

[*.{md,mdx}]
trim_trailing_whitespace = false

[go.mod]
indent_style = tab
indent_size = tab
