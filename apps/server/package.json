{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:0:generate": "npm run prisma:generate",
    "db:1:migrate:local": "npm run prisma:migrate",
    "db:2:apply:turso": "vpx scripts/applyMigration.ts",
    "db:3:seed:turso": "npm run seed",
    "dev": "vpx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "lint": "vp lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "npm run db:2:apply:turso",
    "seed": "vpx prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@prisma/adapter-libsql": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.17",
    "globals": "^16.3.0",
    "prisma": "^6.19.0",
    "typescript": "^5.5.4",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  }
}
