# Public app: docker compose up --build -d
PC_CONFIGURATOR_PORT=8080
PC_CONFIGURATOR_BIND=127.0.0.1

# Management: docker compose -f compose.yaml -f compose.auth.yaml up --build -d
PC_CONFIGURATOR_PUBLIC_URL=http://127.0.0.1:8080
PC_CONFIGURATOR_OWNER_EMAIL=owner@example.com
NOX_AUTH_PUBLIC_URL=https://auth.example.com
NOX_SUITE_LOCAL_VOLUME_NAME=nox-suite-local
NOX_AUTH_ADMIN_VOLUME_NAME=nox-auth-admin
